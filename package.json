{
  "name": "planary-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev -p 3009",
    "build": "next build",
    "start": "next start -p 3009",
    "lint": "eslint",
    "api": "wrangler dev --port 8790",
    "api:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply planary-vault --local",
    "db:migrate": "wrangler d1 migrations apply planary-vault --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p api"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "next": "16.3.5",
    "pdfjs-dist": "^5.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
