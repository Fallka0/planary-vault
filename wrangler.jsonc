{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planary-vault-api",
  "main": "api/worker.ts",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "planary-vault", "database_id": "b9f52f54-2658-42ae-9297-5f262479769f", "migrations_dir": "api/migrations" }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "planary-vault-blobs" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://vault.planary.ch"
  }
}
